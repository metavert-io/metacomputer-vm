diff --git a/libs/lume/tests/MCompVMNameTests.swift b/libs/lume/tests/MCompVMNameTests.swift
new file mode 100644
index 0000000..71708aa
--- /dev/null
+++ b/libs/lume/tests/MCompVMNameTests.swift
@@ -0,0 +1,35 @@
+import ArgumentParser
+import Testing
+
+@testable import lume
+
+@MainActor
+@Suite("mcomp-vm's name and version")
+struct MCompVMNameTests {
+    @Test("--version prints the Lume version and the mcomp-vm revision")
+    func versionNamesTheBuild() {
+        #expect(Lume.configuration.version == "\(Lume.Version.current)-mcomp.\(MCompVM.revision)")
+    }
+
+    @Test("Usage lines name the command mcomp-vm")
+    func usageNamesTheCommand() {
+        #expect(Lume.configuration.commandName == "mcomp-vm")
+        #expect(Lume.helpMessage(for: Run.self, columns: 200).contains("USAGE: mcomp-vm run "))
+    }
+
+    @Test("The help banner names mcomp-vm as a build of Lume, without Lume's logo")
+    func bannerNamesTheBuild() {
+        let lines = Lume.banner.split(separator: "\n").map(String.init)
+        #expect(
+            lines.first
+                == "mcomp-vm \(MCompVM.version): metacomputer's build of Lume \(Lume.Version.current)")
+        // Lume's banner drew a logo in Braille characters.
+        #expect(!Lume.banner.unicodeScalars.contains { (0x2800...0x28FF).contains($0.value) })
+    }
+
+    @Test("Lume's own version is unchanged for the API, the update check and telemetry")
+    func lumeVersionUnchanged() {
+        #expect(!Lume.Version.current.contains("mcomp"))
+        #expect(MCompVM.version.hasPrefix(Lume.Version.current + "-mcomp."))
+    }
+}
