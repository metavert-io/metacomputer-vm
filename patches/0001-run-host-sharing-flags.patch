diff --git a/libs/lume/tests/HostSharingTests.swift b/libs/lume/tests/HostSharingTests.swift
new file mode 100644
index 0000000..5d4025d
--- /dev/null
+++ b/libs/lume/tests/HostSharingTests.swift
@@ -0,0 +1,56 @@
+import Testing
+import Virtualization
+
+@testable import lume
+
+@MainActor
+@Test("run shares the clipboard, audio and Rosetta by default")
+func runSharesEverythingByDefault() throws {
+    let command = try #require(try Lume.parseAsRoot(["run", "test-vm"]) as? Run)
+    #expect(command.hostSharing == .all)
+}
+
+@MainActor
+@Test("run --no-host-sharing isolates the guest from the host")
+func runNoHostSharing() throws {
+    let command = try #require(try Lume.parseAsRoot(["run", "test-vm", "--no-host-sharing"]) as? Run)
+    #expect(command.hostSharing == .none)
+}
+
+@MainActor
+@Test("run --no-share-* turns off one resource at a time")
+func runIndividualOptOuts() throws {
+    let noClipboard = try #require(try Lume.parseAsRoot(["run", "vm", "--no-share-clipboard"]) as? Run)
+    #expect(noClipboard.hostSharing == HostSharing(clipboard: false, audio: true, rosetta: true))
+    let noAudio = try #require(try Lume.parseAsRoot(["run", "vm", "--no-share-audio"]) as? Run)
+    #expect(noAudio.hostSharing == HostSharing(clipboard: true, audio: false, rosetta: true))
+    let noRosetta = try #require(try Lume.parseAsRoot(["run", "vm", "--no-share-rosetta"]) as? Run)
+    #expect(noRosetta.hostSharing == HostSharing(clipboard: true, audio: true, rosetta: false))
+}
+
+@MainActor
+@Test("run --clipboard (SSH sync) is independent of host sharing")
+func runSSHClipboardIndependent() throws {
+    let command = try #require(
+        try Lume.parseAsRoot(["run", "vm", "--clipboard", "--no-host-sharing"]) as? Run)
+    #expect(command.clipboard)
+    #expect(command.hostSharing == .none)
+}
+
+@Test("HostSharing attaches only the devices it allows")
+func hostSharingAttachesAllowedDevices() {
+    let all = VZVirtualMachineConfiguration()
+    HostSharing.all.attachDevices(to: all)
+    #expect(all.audioDevices.count == 1)
+    #expect(all.consoleDevices.count == 1)
+
+    let none = VZVirtualMachineConfiguration()
+    HostSharing.none.attachDevices(to: none)
+    #expect(none.audioDevices.isEmpty)
+    #expect(none.consoleDevices.isEmpty)
+
+    let clipboardOnly = VZVirtualMachineConfiguration()
+    HostSharing(clipboard: true, audio: false, rosetta: false).attachDevices(to: clipboardOnly)
+    #expect(clipboardOnly.audioDevices.isEmpty)
+    #expect(clipboardOnly.consoleDevices.count == 1)
+}
