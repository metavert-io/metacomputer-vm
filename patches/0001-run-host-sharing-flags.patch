From: Metavert LLC <jon@metavert.io>
Subject: [PATCH] lume run: opt-out flags for host sharing (clipboard, audio, Rosetta)

Lume attaches three host-sharing devices to every VM: the SPICE agent
console port with clipboard sharing, a virtio sound device wired to the
host speakers and microphone, and (Linux guests) the Rosetta share.
Defaults are unchanged. New flags turn each off:
  --no-share-clipboard  --no-share-audio  --no-share-rosetta
  --no-host-sharing     (all three)
A saved state taken with other devices falls back to a boot (restoreOrBoot).

---
 libs/lume/src/Commands/Run.swift                   | 30 ++++++-
 libs/lume/src/LumeController.swift                 |  6 +-
 libs/lume/src/VM/VM.swift                          |  6 +-
 .../Virtualization/VMVirtualizationService.swift   | 94 ++++++++++++----------
 libs/lume/tests/HostSharingTests.swift             | 56 +++++++++++++
 libs/lume/tests/Mocks/MockVM.swift                 |  5 +-
 6 files changed, 150 insertions(+), 47 deletions(-)

diff --git a/libs/lume/src/Commands/Run.swift b/libs/lume/src/Commands/Run.swift
index 37827b9..c09e243 100644
--- a/libs/lume/src/Commands/Run.swift
+++ b/libs/lume/src/Commands/Run.swift
@@ -112,6 +112,33 @@ struct Run: AsyncParsableCommand {
     )
     var clipboard: Bool = false
 
+    @Flag(
+        inversion: .prefixedNo,
+        help: "Share the host clipboard with the guest through the SPICE agent port (default: on).")
+    var shareClipboard: Bool = true
+
+    @Flag(
+        inversion: .prefixedNo,
+        help: "Attach a sound device connected to the host's audio output and microphone (default: on).")
+    var shareAudio: Bool = true
+
+    @Flag(
+        inversion: .prefixedNo,
+        help: "Linux guests: share Rosetta for running x86-64 binaries (default: on when installed).")
+    var shareRosetta: Bool = true
+
+    @Flag(
+        name: .customLong("no-host-sharing"),
+        help: "Isolate the guest from the host: --no-share-clipboard --no-share-audio --no-share-rosetta.")
+    var noHostSharing: Bool = false
+
+    /// What the guest shares with the host: everything unless turned off.
+    var hostSharing: HostSharing {
+        noHostSharing
+            ? .none
+            : HostSharing(clipboard: shareClipboard, audio: shareAudio, rosetta: shareRosetta)
+    }
+
     private var parsedNetworkMode: NetworkMode? {
         get throws {
             guard let network else {
@@ -225,7 +252,8 @@ struct Run: AsyncParsableCommand {
             additionalDiskPaths: parsedAdditionalDisks.isEmpty ? nil : parsedAdditionalDisks,
             networkMode: parsedNetworkMode,
             clipboard: clipboard,
-            vncPolicy: vnc
+            vncPolicy: vnc,
+            hostSharing: hostSharing
         )
     }
 }
