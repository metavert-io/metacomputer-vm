@@ -19,6 +19,54 @@ struct VMVirtualizationServiceContext {
     let networkMode: NetworkMode
     /// Adds a virtio socket device (for host port forwards over vsock).
     var socketDevice: Bool = false
+    /// Host resources shared with the guest (clipboard, audio, Rosetta). All by default.
+    var hostSharing: HostSharing = .all
+}
+
+/// Host resources a VM is connected to. Lume shares all of them by default;
+/// `lume run --no-share-clipboard`, `--no-share-audio`, `--no-share-rosetta`
+/// or `--no-host-sharing` leaves them out, for guests that should stay
+/// isolated from the host (untrusted software, automation).
+public struct HostSharing: Sendable, Equatable {
+    /// The SPICE agent console port with clipboard sharing.
+    public var clipboard: Bool
+    /// A virtio sound device wired to the host's audio output and input.
+    public var audio: Bool
+    /// Linux guests: the Rosetta directory share for x86-64 binaries.
+    public var rosetta: Bool
+
+    public init(clipboard: Bool = true, audio: Bool = true, rosetta: Bool = true) {
+        self.clipboard = clipboard
+        self.audio = audio
+        self.rosetta = rosetta
+    }
+
+    public static let all = HostSharing()
+    public static let none = HostSharing(clipboard: false, audio: false, rosetta: false)
+
+    /// Adds the audio and clipboard devices this value allows. Rosetta is a
+    /// directory share and is handled with the other shares (Linux guests).
+    func attachDevices(to vzConfig: VZVirtualMachineConfiguration) {
+        if audio {
+            let soundDeviceConfiguration = VZVirtioSoundDeviceConfiguration()
+            let inputAudioStreamConfiguration = VZVirtioSoundDeviceInputStreamConfiguration()
+            let outputAudioStreamConfiguration = VZVirtioSoundDeviceOutputStreamConfiguration()
+            inputAudioStreamConfiguration.source = VZHostAudioInputStreamSource()
+            outputAudioStreamConfiguration.sink = VZHostAudioOutputStreamSink()
+            soundDeviceConfiguration.streams = [inputAudioStreamConfiguration, outputAudioStreamConfiguration]
+            vzConfig.audioDevices = [soundDeviceConfiguration]
+        }
+        if clipboard {
+            let spiceAgentConsoleDevice = VZVirtioConsoleDeviceConfiguration()
+            let spiceAgentPort = VZVirtioConsolePortConfiguration()
+            spiceAgentPort.name = VZSpiceAgentPortAttachment.spiceAgentPortName
+            let spiceAgentPortAttachment = VZSpiceAgentPortAttachment()
+            spiceAgentPortAttachment.sharesClipboard = true
+            spiceAgentPort.attachment = spiceAgentPortAttachment
+            spiceAgentConsoleDevice.ports[0] = spiceAgentPort
+            vzConfig.consoleDevices.append(spiceAgentConsoleDevice)
+        }
+    }
 }
 
